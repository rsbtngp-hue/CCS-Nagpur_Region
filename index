            const makeSubDivision = (division, subDivision) => ({
              subDivision,
              division,
              centers: new Map(),
              activeCenters: 0,
              inactiveCenters: 0,
              enrol: 0,
              update: 0,
              totalTrans: 0,
              revenue: 0,
