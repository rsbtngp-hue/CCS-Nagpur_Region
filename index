            // ----------------------------------------------------------------------

            const aadharReportingCount = masterAadhaarOffices.filter((o) => aadharReportingOffices.has(o.name)).length;
            const masterGangajalOffices = regionalMasterOffices.filter((o) => o.isGangajal);
            const gangajalTotalOffices = masterGangajalOffices.length;
            const gangajalReportedCount = masterGangajalOffices.filter((o) => gangajalReportedOffices.has(o.name)).length;
            const gangajalUnreportedCount = Math.max(0, gangajalTotalOffices - gangajalReportedCount);
            const masterPopskOffices = regionalMasterOffices.filter((o) => o.isPopsk);
            const popskSetCount = masterPopskOffices.length;
