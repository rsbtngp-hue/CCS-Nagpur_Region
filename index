<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CCS Performance Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Import Maps for React and Dependencies -->
    <script type="importmap">
    {
        "imports": {
            "react": "https://esm.sh/react@18.2.0",
            "react-dom/client": "https://esm.sh/react-dom@18.2.0/client",
            "@dnd-kit/core": "https://esm.sh/@dnd-kit/core@6.1.0?external=react",
            "@dnd-kit/sortable": "https://esm.sh/@dnd-kit/sortable@8.0.0?external=react",
            "@dnd-kit/utilities": "https://esm.sh/@dnd-kit/utilities@3.2.2?external=react",
            "lucide-react": "https://esm.sh/lucide-react@0.344.0?external=react",
            "d3": "https://esm.sh/d3@7.8.5"
        }
    }
    </script>
    
    <!-- Babel for in-browser JSX compilation -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }

        /* ===== Refined dashboard presentation layer ===== */
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; color: #0f172a; overflow-x: hidden; }
        button, input, select { font: inherit; }
        button { -webkit-tap-highlight-color: transparent; }
        .shadow-xs { box-shadow: 0 1px 2px rgba(15,23,42,.05), 0 1px 3px rgba(15,23,42,.04); }
        .shadow-2xs { box-shadow: 0 1px 1px rgba(15,23,42,.04); }
        header.sticky { backdrop-filter: saturate(180%) blur(8px); background: rgba(255,255,255,.96); }
        header .max-w-7xl, main.max-w-7xl { max-width: 1600px; }
        main { min-width: 0; }
        main > section, main > div { min-width: 0; }
        table { border-collapse: separate; border-spacing: 0; }
        .overflow-x-auto { scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent; }
        .overflow-x-auto::-webkit-scrollbar { height: 8px; }
        .overflow-x-auto::-webkit-scrollbar-track { background: transparent; }
        .overflow-x-auto::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }
        input:focus, select:focus, button:focus-visible { outline: none; }
        input:focus, select:focus { box-shadow: 0 0 0 3px rgba(99,102,241,.12); }

        /* Keep KPI figures fully visible instead of allowing flex shrink to clip digits. */
        .font-mono { font-variant-numeric: tabular-nums; }
        .flex.items-baseline.justify-between > .font-mono,
        .flex.items-center.justify-between > .font-mono,
        .flex.items-baseline.justify-between > span:last-child,
        .flex.items-center.justify-between > span:last-child { flex: 0 0 auto; min-width: max-content; }
        .text-2xl.font-extrabold.font-mono,
        .text-lg.font-extrabold.font-mono { white-space: nowrap; overflow: visible; }

        /* KPI cards: consistent height, padding and responsive grid behavior. */
        main .grid > .rounded-xl { min-width: 0; }
        main .grid > .rounded-xl .font-mono { letter-spacing: -.015em; }
        main .grid > .rounded-xl span, main .grid > .rounded-xl strong { overflow-wrap: normal; }

        /* Long headings/tabs should wrap only where necessary, never clip. */
        h1, h2, h3, h4 { text-wrap: balance; }
        .whitespace-nowrap { overflow: visible; }

        /* Status badge added to the main heading area. */
        .mis-status-box { flex: 0 0 auto; min-width: 205px; max-width: 100%; }
        .mis-status-date { white-space: nowrap; font-variant-numeric: tabular-nums; }

        @media (max-width: 900px) {
          header .max-w-7xl, main.max-w-7xl { max-width: 100%; }
          main { padding-top: 1rem !important; }
          .mis-status-box { min-width: 0; width: 100%; }
        }
        @media (max-width: 640px) {
          header .max-w-7xl { padding-left: .75rem; padding-right: .75rem; }
          main.max-w-7xl { padding-left: .75rem; padding-right: .75rem; }
          header h1 { font-size: 1rem; line-height: 1.25rem; }
          header .w-10.h-10 { width: 2.25rem; height: 2.25rem; flex: 0 0 2.25rem; }
          .mis-status-box { order: -1; }
        }

        /* ===== Aadhaar interaction / report refinements ===== */
        .report-export-controls { justify-content: center !important; width: 100%; }
        .clickable-report-value { cursor: pointer; text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 3px; }
        .clickable-report-value:hover { filter: brightness(.88); }
        .aadhaar-daily-table { width: 100%; table-layout: auto; }
        .aadhaar-daily-table th, .aadhaar-daily-table td { white-space: nowrap; }
        .aadhaar-daily-table th:first-child, .aadhaar-daily-table td:first-child { white-space: normal; width: 360px; min-width: 360px; }
        .aadhaar-center-detail-label { width: 34%; background: #f8fafc; font-weight: 700; color: #475569; }
        @media (max-width: 1100px) {
          .aadhaar-daily-table th:first-child, .aadhaar-daily-table td:first-child { width: 300px; min-width: 300px; }
        }
        @media print {
          header.sticky { position: static !important; box-shadow: none !important; }
          .no-print { display: none !important; }
          body { background: #fff; }
          main { max-width: none !important; }
          .overflow-x-auto { overflow: visible !important; }
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel" data-type="module">
        import React, { useState, useMemo, useRef, useEffect } from 'react';
        import { createRoot } from 'react-dom/client';
        import * as d3 from 'd3';
        import { DndContext, closestCenter, PointerSensor, useSensor, useSensors } from '@dnd-kit/core';
        import { SortableContext, verticalListSortingStrategy, useSortable } from '@dnd-kit/sortable';
        import { CSS } from '@dnd-kit/utilities';
        import { Building2, TrendingUp, IndianRupee, FileText, ShieldAlert, Search, Plus, Edit2, Trash2, X, ChevronDown, ChevronUp, Calendar, Layers, BarChart3, Award, CheckCircle, AlertCircle, GripVertical, ChevronLeft, ChevronRight, Filter, RefreshCw, Eye, Check, Fingerprint, Droplets, Maximize2, Minimize2, Target, Save } from 'lucide-react';

        const INDIA_POST_LOGO_DATA = "data:image/png;base64,";
        const INDIA_POST_ORGANISATION = "Department of Posts • Maharashtra Circle";

        function escapeReportHtml(value) {
          return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function makeReportFileName(title) {
          return String(title || 'Report').replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '').slice(0, 80) || 'Report';
        }

        function ReportExportButtons({ tableId, title, reportPeriod }) {
          const getTable = () => document.getElementById(tableId);
          const exportExcel = () => {
            const table = getTable();
            if (!table) { alert('Report table is not available.'); return; }
            const clone = table.cloneNode(true);
            clone.querySelectorAll('[data-export-ignore="true"]').forEach((el) => el.remove());
            const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><style>body{font-family:Arial,sans-serif;font-size:10pt}h1{font-size:18pt;text-align:center;margin:6px 0}h2{font-size:11pt;text-align:center;margin:2px 0 10px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #999;padding:5px 7px;vertical-align:top}th{background:#e5e7eb;font-weight:700}img{max-height:70px;display:block;margin:0 auto 6px}</style></head><body><img src="${INDIA_POST_LOGO_DATA}"><h1>${escapeReportHtml(title)}</h1><h2>Report Period: ${escapeReportHtml(reportPeriod)}</h2>${clone.outerHTML}<div style="margin-top:10px;font-size:9pt;color:#555">${escapeReportHtml(INDIA_POST_ORGANISATION)}</div></body></html>`;
            const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = `${makeReportFileName(title)}.xls`; document.body.appendChild(a); a.click(); a.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1500);
          };
          const exportPdf = () => {
            const table = getTable();
            if (!table) { alert('Report table is not available.'); return; }
            const clone = table.cloneNode(true);
            clone.querySelectorAll('[data-export-ignore="true"]').forEach((el) => el.remove());
            const win = window.open('', '_blank', 'width=1400,height=900');
            if (!win) { alert('Please allow pop-ups for PDF export.'); return; }
            win.document.open();
            win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${escapeReportHtml(title)}</title><style>@page{size:A3 landscape;margin:10mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#111;margin:0;font-size:9pt}.report-head{position:relative;text-align:center;margin-bottom:10px;padding:4px 90px 4px 90px}.report-head img{position:absolute;left:0;top:0;max-height:70px;max-width:170px;object-fit:contain}h1{font-size:17pt;margin:5px 0}h2{font-size:10pt;margin:3px 0 8px;font-weight:600}table{border-collapse:collapse;width:100%;table-layout:auto}th,td{border:1px solid #777;padding:5px 6px;vertical-align:top;word-break:break-word}th{background:#e5e7eb;font-weight:700}.sticky{position:static!important}.report-foot{margin-top:8px;font-size:8pt;color:#555;text-align:center}tr{break-inside:avoid}</style></head><body><div class="report-head"><img src="${INDIA_POST_LOGO_DATA}"><h1>${escapeReportHtml(title)}</h1><h2>Report Period: ${escapeReportHtml(reportPeriod)}</h2></div>${clone.outerHTML}<div class="report-foot">${escapeReportHtml(INDIA_POST_ORGANISATION)} • Generated from CCS Performance Dashboard</div></body></html>`);
            win.document.close();
            setTimeout(() => { win.focus(); win.print(); }, 700);
          };
          return (
            <div className="report-export-controls flex items-center justify-center gap-1.5 flex-wrap w-full" data-export-ignore="true">
              <button type="button" onClick={exportPdf} title="Open print dialog to save this section as PDF" className="text-[10px] font-bold px-2.5 py-1.5 rounded-lg border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 flex items-center gap-1.5 shadow-2xs"><FileText className="w-3.5 h-3.5" /> PDF</button>
              <button type="button" onClick={exportExcel} title="Export this section as an Excel-compatible workbook" className="text-[10px] font-bold px-2.5 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 flex items-center gap-1.5 shadow-2xs"><BarChart3 className="w-3.5 h-3.5" /> Excel</button>
            </div>
          );
        }

        function parseNum(val) {
          if (val === null || val === undefined || val === '') return 0;
          const cleaned = String(val).replace(/[^0-9.-]+/g, '');
          const n = parseFloat(cleaned);
          return isNaN(n) ? 0 : n;
        }

        function formatDateSafe(str) {
          if (!str) return 'N/A';
          const s = String(str).trim();
          const parts = s.split('-');
          if (parts.length === 3) {
            const y = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10);
            const d = parseInt(parts[2], 10);
            if (!isNaN(y) && !isNaN(m) && !isNaN(d)) {
              const date = new Date(y, m - 1, d);
              return date.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
            }
          }
          return s;
        }

        const initialDivisionTargets = [
          { id: 1, division: 'Akola Division', annualEnrol: 7118, annualUpdate: 51880, monthlyEnrol: 593, monthlyUpdate: 4323 },
          { id: 2, division: 'Amaravati Division', annualEnrol: 6575, annualUpdate: 47890, monthlyEnrol: 548, monthlyUpdate: 3991 },
          { id: 3, division: 'Buldana Division', annualEnrol: 5480, annualUpdate: 39910, monthlyEnrol: 457, monthlyUpdate: 3325 },
          { id: 4, division: 'Chandrapur Division', annualEnrol: 4110, annualUpdate: 29933, monthlyEnrol: 343, monthlyUpdate: 2495 },
          { id: 5, division: 'Gadchiroli Division', annualEnrol: 4110, annualUpdate: 29932, monthlyEnrol: 342, monthlyUpdate: 2494 },
          { id: 6, division: 'Nagpur City Division', annualEnrol: 8220, annualUpdate: 59865, monthlyEnrol: 685, monthlyUpdate: 4989 },
          { id: 7, division: 'Nagpur Moffusil Division', annualEnrol: 8220, annualUpdate: 59865, monthlyEnrol: 685, monthlyUpdate: 4989 },
          { id: 8, division: 'Wardha Division', annualEnrol: 4380, annualUpdate: 31920, monthlyEnrol: 365, monthlyUpdate: 2660 },
          { id: 9, division: 'Yeotmal Division', annualEnrol: 6575, annualUpdate: 47890, monthlyEnrol: 548, monthlyUpdate: 3991 },
        ];

        function SortableTableRow({ item, colMap, isExpanded, onToggleExpand, onEdit, onDelete }) {
          const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({ id: String(item.index_) });

          const style = {
            transform: CSS.Transform.toString(transform),
            transition,
            opacity: isDragging ? 0.4 : 1,
            position: 'relative',
            zIndex: isDragging ? 10 : 1,
          };

          const row = item.row || [];
          const dateVal = row[colMap.date];
          const officeName = row[colMap.officeName] || 'Unnamed Office';
          const officeId = row[colMap.officeId];
          const officeType = row[colMap.officeType] || 'N/A';
          const division = row[colMap.division] || 'N/A';
          const subDiv = row[colMap.subDiv] || 'N/A';
          const app473 = parseNum(row[colMap.app473]);
          const pcc120 = parseNum(row[colMap.pcc120]);
          const gangajal = parseNum(row[colMap.gangajal]);
          const aadharRev = parseNum(row[colMap.aadharRevenue]);
          const totalRev = (app473 * 473) + (pcc120 * 120) + (gangajal * 30) + aadharRev;

          const typeColor =
            officeType === 'HPO' ? 'bg-blue-50 text-blue-700 border-blue-200'
              : officeType === 'GPO' ? 'bg-purple-50 text-purple-700 border-purple-200'
              : officeType === 'SPO' ? 'bg-amber-50 text-amber-700 border-amber-200'
              : officeType === 'BPC' ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
              : 'bg-slate-50 text-slate-700 border-slate-200';

          return (
            <React.Fragment>
              <tr ref={setNodeRef} style={style} className={`border-b border-slate-100 hover:bg-slate-50/80 transition-colors ${isExpanded ? 'bg-indigo-50/20' : ''}`}>
                <td className="py-3 px-3 w-10 text-center">
                  <button {...attributes} {...listeners} className="cursor-grab active:cursor-grabbing text-slate-300 hover:text-slate-600 p-1 inline-flex items-center rounded" title="Drag to reorder row">
                    <GripVertical className="w-4 h-4" />
                  </button>
                </td>
                <td className="py-3 px-3 text-center w-10">
                  <button onClick={() => onToggleExpand(item.index_)} className="text-slate-400 hover:text-slate-700 p-1 rounded hover:bg-slate-100 transition-colors" title={isExpanded ? 'Collapse row details' : 'Expand full details'}>
                    {isExpanded ? <ChevronUp className="w-4 h-4 text-indigo-600" /> : <ChevronDown className="w-4 h-4" />}
                  </button>
                </td>
                <td className="py-3 px-4 text-xs font-medium text-slate-700 whitespace-nowrap">{formatDateSafe(dateVal)}</td>
                <td className="py-3 px-4">
                  <div className="font-semibold text-slate-900 text-sm flex items-center gap-1.5">{officeName}</div>
                  <div className="text-xs text-slate-400 font-mono">{officeId ? `ID: ${officeId}` : ''}</div>
                </td>
                <td className="py-3 px-3 text-center whitespace-nowrap">
                  <span className={`inline-flex px-2 py-0.5 text-xs font-semibold rounded-full border ${typeColor}`}>{officeType}</span>
                </td>
                <td className="py-3 px-4">
                  <div className="text-xs font-medium text-slate-800">{division}</div>
                  <div className="text-xs text-slate-400 truncate max-w-[140px]" title={subDiv}>{subDiv}</div>
                </td>
                <td className="py-3 px-4 text-right font-medium text-slate-900 text-sm">
                  {app473 > 0 ? <span className="font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">{app473.toLocaleString()}</span> : <span className="text-slate-300">-</span>}
                </td>
                <td className="py-3 px-4 text-right font-medium text-slate-900 text-sm">
                  {pcc120 > 0 ? <span className="font-semibold text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-100">{pcc120.toLocaleString()}</span> : <span className="text-slate-300">-</span>}
                </td>
                <td className="py-3 px-4 text-right font-semibold text-slate-900 text-sm whitespace-nowrap">
                  {totalRev > 0 ? `₹${Math.round(totalRev).toLocaleString('en-IN')}` : <span className="text-slate-300 font-normal">₹0</span>}
                </td>
                <td className="py-3 px-4 text-center whitespace-nowrap">
                  <div className="flex items-center justify-center gap-1">
                    <button onClick={() => onEdit(item)} className="p-1.5 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors" title="Edit record"><Edit2 className="w-3.5 h-3.5" /></button>
                    <button onClick={() => onDelete(item)} className="p-1.5 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded transition-colors" title="Delete record"><Trash2 className="w-3.5 h-3.5" /></button>
                  </div>
                </td>
              </tr>
              {isExpanded && (
                <tr className="bg-indigo-50/30 border-b border-slate-200">
                  <td colSpan={10} className="p-4 sm:p-5">
                    <div className="bg-white rounded-lg border border-indigo-100 p-4 shadow-xs">
                      <div className="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-3">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded">Detailed Record Metrics</span>
                          <span className="text-xs text-slate-500">Row Index: {item.index_}</span>
                        </div>
                        <div className="text-xs text-slate-500">Station ID: <span className="font-mono font-medium text-slate-700">{row[colMap.stationId] || 'Not Assigned'}</span></div>
                      </div>
                      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div className="bg-slate-50 p-2.5 rounded border border-slate-100">
                          <span className="text-slate-500 block mb-0.5">App @ ₹473 Amount</span>
                          <span className="font-semibold text-slate-800 text-sm">₹{(app473 * 473).toLocaleString('en-IN')}</span>
                        </div>
                        <div className="bg-slate-50 p-2.5 rounded border border-slate-100">
                          <span className="text-slate-500 block mb-0.5">PCC @ ₹120 Amount</span>
                          <span className="font-semibold text-slate-800 text-sm">₹{(pcc120 * 120).toLocaleString('en-IN')}</span>
                        </div>
                        <div className="bg-slate-50 p-2.5 rounded border border-slate-100">
                          <span className="text-slate-500 block mb-0.5">Gangajal Sold (@ ₹30)</span>
                          <span className="font-semibold text-slate-800 text-sm">{gangajal} (₹{(gangajal * 30).toLocaleString('en-IN')})</span>
                        </div>
                        <div className="bg-slate-50 p-2.5 rounded border border-slate-100">
                          <span className="text-slate-500 block mb-0.5">Aadhar Station Kits</span>
                          <span className="font-semibold text-slate-800 text-sm">{row[colMap.kits] !== null && row[colMap.kits] !== undefined ? row[colMap.kits] : '0'}</span>
                        </div>
                      </div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3 pt-3 border-t border-slate-100 text-xs">
                        <div>
                          <span className="font-semibold text-slate-700 block mb-1">Counter Transactions</span>
                          <div className="text-slate-600 flex justify-between bg-slate-50 p-2 rounded">
                            <span>Enrolment / Updation:</span>
                            <span className="font-medium">{parseNum(row[colMap.counterEnrol])} / {parseNum(row[colMap.counterUpdate])}</span>
                          </div>
                        </div>
                        <div>
                          <span className="font-semibold text-slate-700 block mb-1">MBU Camps</span>
                          <div className="text-slate-600 flex justify-between bg-slate-50 p-2 rounded">
                            <span>Camps / Trans:</span>
                            <span className="font-medium">{parseNum(row[colMap.mbuCamps])} Camps ({parseNum(row[colMap.mbuEnrol]) + parseNum(row[colMap.mbuUpdate])} trans)</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              )}
            </React.Fragment>
          );
        }

        function App({ data = [], updateItem, deleteItem, insertItem, moveItem, onRefresh, isRefreshing, lastSynced }) {
          const [fromDate, setFromDate] = useState('');
          const [toDate, setToDate] = useState('');
          const [selectedMonth, setSelectedMonth] = useState('ALL');
          const [selectedDivision, setSelectedDivision] = useState('ALL');
          const [selectedSubDivision, setSelectedSubDivision] = useState('ALL');
          const [searchQuery, setSearchQuery] = useState('');
          const [activeTab, setActiveTab] = useState('overview'); 
          const [masterAadhaarFilter, setMasterAadhaarFilter] = useState('ALL'); 
          const [divisionTargets, setDivisionTargets] = useState(initialDivisionTargets);
          const [isEditingTargets, setIsEditingTargets] = useState(false);
          const [targetViewPeriod, setTargetViewPeriod] = useState('MONTHLY'); 
          const [targetMetricFilter, setTargetMetricFilter] = useState('ALL');
          // Dedicated Aadhaar 2026-27 Target View filters.
          const getLocalTodayKey = () => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
          };
          const [targetFromDate, setTargetFromDate] = useState('2026-04-01');
          const [targetToDate, setTargetToDate] = useState(getLocalTodayKey); 
          const [targetMonth, setTargetMonth] = useState('ALL'); 
          const [aadhaarSubView, setAadhaarSubView] = useState('ALL');
          // Aadhaar Daily Transaction Report filters (independent of the dashboard-wide filters)
          // Daily report opens on today's date by default.
          const [aadhaarDailyFromDate, setAadhaarDailyFromDate] = useState(getLocalTodayKey);
          const [aadhaarDailyToDate, setAadhaarDailyToDate] = useState(getLocalTodayKey);
          const [aadhaarDailyDivision, setAadhaarDailyDivision] = useState('ALL');
          const [aadhaarDailySubDivision, setAadhaarDailySubDivision] = useState('ALL');
          const [expandedRows, setExpandedRows] = useState(new Set());
          const [currentPage, setCurrentPage] = useState(1);
          const rowsPerPage = 12;

          const [expandedAadhaarDivs, setExpandedAadhaarDivs] = useState(new Set());
          const [expandedAadhaarSubDivs, setExpandedAadhaarSubDivs] = useState(new Set());
          const [expandedAadhaarCenters, setExpandedAadhaarCenters] = useState(new Set());
          const [expandedDailyAadhaarDivs, setExpandedDailyAadhaarDivs] = useState(new Set());
