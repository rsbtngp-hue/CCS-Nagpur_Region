          // ======================================================================
          const aadhaarDailyReportFilters = useMemo(() => {
            const norm = (v) => String(v ?? '').trim().toLowerCase().replace(/\s+/g, ' ');
            const dateKey = (v) => {
              const raw = String(v ?? '').trim();
              if (!raw) return '';
              const m1 = raw.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
              if (m1) return `${m1[1]}-${String(m1[2]).padStart(2,'0')}-${String(m1[3]).padStart(2,'0')}`;
              const m2 = raw.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})/);
              if (m2) return `${m2[3]}-${String(m2[2]).padStart(2,'0')}-${String(m2[1]).padStart(2,'0')}`;
              const dt = new Date(raw);
              if (!Number.isNaN(dt.getTime())) return `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;
              return raw;
