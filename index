            // dashboard filters (date/month/division/sub-division/search).
            // For each Aadhaar centre, the latest Column J status inside that
            // selected period is used; if duplicate rows exist on the same
            // date, INACTIVE takes precedence. Column K remains the reason.
            const normalizeOfficeKey = (v) => String(v ?? '')
              .toLowerCase().replace(/&amp;/g, '&').replace(/[^a-z0-9]+/g, ' ').trim();
            const normalizeStatusDate = (v) => {
              const raw = String(v ?? '').trim();
              if (!raw) return '';
              const m = raw.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
              if (m) return `${m[3]}-${String(m[2]).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}`;
              const iso = raw.match(/^(\d{4})[\/-](\d{1,2})[\/-](\d{1,2})/);
              if (iso) return `${iso[1]}-${String(iso[2]).padStart(2,'0')}-${String(iso[3]).padStart(2,'0')}`;
              const d = new Date(raw);
              return Number.isNaN(d.getTime()) ? raw : `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
            };

            const masterAadhaarOfficesForStatus = masterAadhaarOffices.filter((o) => {
              const div = String(o.division || '').trim();
              const sub = String(o.subDiv || '').trim();
              const name = String(o.name || '').toLowerCase();
              const id = String(o.id || '').toLowerCase();
              if (selectedDivision !== 'ALL' && div !== selectedDivision) return false;
              if (selectedSubDivision !== 'ALL' && sub !== selectedSubDivision) return false;
              if (searchQuery.trim()) {
                const q = searchQuery.toLowerCase().trim();
                if (!(name.includes(q) || sub.toLowerCase().includes(q) || id.includes(q) || div.toLowerCase().includes(q))) return false;
              }
              return true;
            });

            const latestStatusMap = new Map();
            const putStatus = (key, rec) => {
              if (!key || key === 'name:') return;
              const current = latestStatusMap.get(key);
              if (!current || rec.dateKey > current.dateKey || (rec.dateKey === current.dateKey && rec.isInactive && !current.isInactive)) {
                latestStatusMap.set(key, rec);
              }
            };

            filteredRows.forEach((d) => {
              const r = d.row || [];
              const offName = String(r[colMap.officeName] || '').trim();
              const offId = String(r[colMap.officeId] || '').trim();
              const dateKey = normalizeStatusDate(r[colMap.date]);
              const statusRaw = String(r[9] ?? '').trim(); // Column J — Status
              const reasonRaw = String(r[10] ?? '').trim(); // Column K — Reason
              const isInactive = /\binactive\b/i.test(statusRaw);
              const isActive = /\bactive\b/i.test(statusRaw) && !isInactive;
              if (!dateKey || (!offName && !offId) || (!isActive && !isInactive)) return;
              const rec = { dateKey, date: String(r[colMap.date] || '').trim(), isInactive, isActive, status: statusRaw, reason: reasonRaw, officeName: offName, officeId: offId };
