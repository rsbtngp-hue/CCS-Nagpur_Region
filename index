              centers: new Set(),
              activeCenters: 0,
              inactiveCenters: 0,
              enrol: 0,
              update: 0,
              totalTrans: 0,
              revenue: 0,
              onlinePay: 0,
              mbuCamps: 0,
              mbuEnrol: 0,
              mbuUpdate: 0,
              mbuTotal: 0,
              mbuLocations: new Set(),
