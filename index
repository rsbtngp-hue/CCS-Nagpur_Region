              const cObj = sObj.centers.get(office);
              if (!cObj) return;

              if (!cObj.stationId && r[colMap.stationId]) cObj.stationId = r[colMap.stationId];

              const cEnr = parseNum(r[colMap.counterEnrol]);
              const cUpd = parseNum(r[colMap.counterUpdate]);
              const cTot = parseNum(r[colMap.counterTotal]) || (cEnr + cUpd);
              const onlinePay = parseNum(r[colMap.onlinePay]);
              const mCamps = parseNum(r[colMap.mbuCamps]);
              const mEnr = parseNum(r[colMap.mbuEnrol]);
              const mUpd = parseNum(r[colMap.mbuUpdate]);
              const mTot = parseNum(r[colMap.mbuTotal]) || (mEnr + mUpd);
              const rev = parseNum(r[colMap.aadharRevenue]);
              const mbuLocation = String(r[colMap.mbuLocation] || '').trim();

              cObj.enrol += cEnr;
              cObj.update += cUpd;
              cObj.totalTrans += cTot;
              cObj.onlinePay += onlinePay;
              cObj.mbuCamps += mCamps;
              cObj.mbuEnrol += mEnr;
              cObj.mbuUpdate += mUpd;
              cObj.mbuTotal += mTot;
              cObj.revenue += rev;
              if (mbuLocation) cObj.mbuLocations.add(mbuLocation);
              cObj.records.push({ item, row: r, cEnr, cUpd, cTot, onlinePay, mCamps, mEnr, mUpd, mTot, rev, mbuLocation });

              sObj.enrol += cEnr;
              sObj.update += cUpd;
              sObj.totalTrans += cTot;
              sObj.onlinePay += onlinePay;
              sObj.mbuCamps += mCamps;
              sObj.mbuEnrol += mEnr;
              sObj.mbuUpdate += mUpd;
              sObj.mbuTotal += mTot;
              sObj.revenue += rev;
              if (mbuLocation) sObj.mbuLocations.add(mbuLocation);

              dObj.enrol += cEnr;
              dObj.update += cUpd;
              dObj.totalTrans += cTot;
              dObj.onlinePay += onlinePay;
              dObj.mbuCamps += mCamps;
              dObj.mbuEnrol += mEnr;
              dObj.mbuUpdate += mUpd;
              dObj.mbuTotal += mTot;
              dObj.revenue += rev;
              if (mbuLocation) dObj.mbuLocations.add(mbuLocation);
            });

            return Array.from(divMap.values())
              .map((d) => ({
                ...d,
                noOfCenters: d.centers.size,
                subDivList: Array.from(d.subDivisions.values()).map((sub) => ({
                  ...sub,
                  noOfCenters: sub.centers.size,
                  centerList: Array.from(sub.centers.values()).map((c) => ({
                    ...c,
                    mbuLocationText: Array.from(c.mbuLocations).join(', '),
                  })),
                  mbuLocationText: Array.from(sub.mbuLocations).join(', '),
                })),
                mbuLocationText: Array.from(d.mbuLocations).join(', '),
              }))
              .sort((a, b) => b.revenue - a.revenue || a.division.localeCompare(b.division));
          }, [filteredRows, colMap, regionalMasterOffices, aadhaarStatusDate]);

          const inactiveAadhaarCenterDetails = useMemo(() => {
            // Popup uses the same authoritative Column J/K matching as the KPI.
            const normalizeOfficeKey = (v) => String(v ?? '')
              .toLowerCase().replace(/&amp;/g, '&').replace(/[^a-z0-9]+/g, ' ').trim();
            const latestMap = new Map();
            filteredRows.forEach((item) => {
              const r = item.row || [];
              const name = String(r[colMap.officeName] || '').trim();
              const officeId = String(r[colMap.officeId] || '').trim();
              const date = String(r[colMap.date] || '').trim();
              if ((!name && !officeId) || !date || (aadhaarStatusDate && date !== aadhaarStatusDate)) return;
              const status = String(r[colMap.active] ?? r[9] ?? '').trim();
              const reason = String(r[colMap.inactiveReason] ?? r[10] ?? '').trim();
              const isInactive = /\binactive\b/i.test(status);
              const isActive = /\bactive\b/i.test(status) && !isInactive;
              if (!isInactive && !isActive) return;
              const key = officeId ? `id:${officeId}` : `name:${normalizeOfficeKey(name)}`;
              const current = latestMap.get(key);
              if (!current || (isInactive && !current.isInactive)) {
                latestMap.set(key, { date, reason, status, isInactive, officeName: name, officeId });
              }
            });
            return regionalMasterOffices.filter((off) => {
              if (!off.isAadhaar) return false;
              const idKey = off.id ? `id:${String(off.id).trim()}` : '';
              const nameKey = `name:${normalizeOfficeKey(off.name)}`;
              const rec = (idKey && latestMap.get(idKey)) || latestMap.get(nameKey);
              return !!rec?.isInactive;
            }).map((off) => {
              const idKey = off.id ? `id:${String(off.id).trim()}` : '';
              const nameKey = `name:${normalizeOfficeKey(off.name)}`;
              const rec = (idKey && latestMap.get(idKey)) || latestMap.get(nameKey) || {};
              return { officeName: off.name, officeId: off.id || '', officeType: off.officeType || '', division: off.division || '', subDiv: off.subDiv || '', inactiveDate: rec.date || '', reason: rec.reason || 'Reason not recorded in Column K / MIS data' };
            }).sort((a,b) => a.division.localeCompare(b.division) || a.subDiv.localeCompare(b.subDiv) || a.officeName.localeCompare(b.officeName));
          }, [filteredRows, colMap, regionalMasterOffices, aadhaarStatusDate]);

          const openInactiveCenterDetails = (scope = {}) => {
            let rows = inactiveAadhaarCenterDetails;
            if (scope.division) rows = rows.filter((x) => x.division === scope.division);
            if (scope.subDiv) rows = rows.filter((x) => x.subDiv === scope.subDiv);
            if (scope.officeName) rows = rows.filter((x) => x.officeName === scope.officeName);
            setInactiveCenterModal({ title: scope.title || 'Inactive Aadhaar Centers', rows });
          };

          const openDailyStatusCenterList = (status) => {
            const rows = [];
            aadhaarDailyReport.forEach((d) => d.subDivisions.forEach((sd) => sd.centers.forEach((c) => {
              const matches = status === 'Active' ? c.active : c.inactive;
              if (!matches) return;
              rows.push({
                officeName: c.officeName,
                officeId: c.officeId,
                division: c.division,
                subDiv: c.subDivision,
                status,
                inactiveDate: c.inactiveDate || '',
                reason: c.inactiveReason || ''
              });
            })));
            rows.sort((a,b) => a.division.localeCompare(b.division) || a.subDiv.localeCompare(b.subDiv) || a.officeName.localeCompare(b.officeName));
            if (status === 'Active') setActiveCenterModal({ title: 'Active Aadhaar Centers', rows });
            else setInactiveCenterModal({ title: 'Inactive Aadhaar Centers', rows });
          };

          const openAadhaarCenterDailyDetails = (center) => {
            const { dateKey } = aadhaarDailyReportFilters;
            const effectiveFrom = dateKey(aadhaarDailyFromDate) || dateKey(aadhaarStatusDate) || aadhaarDailyReportFilters.latest;
            const effectiveTo = dateKey(aadhaarDailyToDate) || dateKey(aadhaarStatusDate) || aadhaarDailyReportFilters.latest;
            const from = effectiveFrom && effectiveTo && effectiveFrom > effectiveTo ? effectiveTo : effectiveFrom;
            const to = effectiveFrom && effectiveTo && effectiveFrom > effectiveTo ? effectiveFrom : effectiveTo;
            const centerId = String(center.officeId || '').trim();
            const centerName = String(center.officeName || '').trim().toLowerCase();
            const rows = dataRows
              .map(item => ({ item, row: item.row || [] }))
              .filter(({row}) => {
                const rowDate = dateKey(row[colMap.date]);
                if (!rowDate || (from && rowDate < from) || (to && rowDate > to)) return false;
                const id = String(row[colMap.officeId] || '').trim();
                const name = String(row[colMap.officeName] || '').trim().toLowerCase();
                return (centerId && id === centerId) || (!centerId && name === centerName) || (centerId && !id && name === centerName);
              })
              .sort((a,b) => dateKey(a.row[colMap.date]).localeCompare(dateKey(b.row[colMap.date])));
            setAadhaarCenterDailyModal({
              center: { ...center, officeName: center.officeName, officeId: center.officeId, division: center.division, subDivision: center.subDivision },
              rows
            });
          };

          const gangajalHierarchy = useMemo(() => {
            const divMap = new Map();
            filteredRows.forEach((item) => {
              const r = item.row || []; const div = String(r[colMap.division] || 'Unassigned Division').trim(); const sub = String(r[colMap.subDiv] || 'Unassigned Sub Division').trim(); const office = String(r[colMap.officeName] || 'Unnamed Office').trim();
              if (!divMap.has(div)) divMap.set(div, { division: div, subDivisions: new Map(), totalBottles: 0, revenue: 0, centers: new Set(), });
              const dObj = divMap.get(div);
              if (!dObj.subDivisions.has(sub)) dObj.subDivisions.set(sub, { subDivision: sub, division: div, centers: new Map(), totalBottles: 0, revenue: 0, });
              const sObj = dObj.subDivisions.get(sub);
              if (!sObj.centers.has(office)) sObj.centers.set(office, { officeName: office, officeId: r[colMap.officeId], officeType: r[colMap.officeType] || 'HPO', division: div, subDivision: sub, totalBottles: 0, revenue: 0, records: [], });
              const cObj = sObj.centers.get(office);
              const bottles = parseNum(r[colMap.gangajal]), rev = bottles * 30;
