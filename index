          const handleUpdateDivisionTarget = (divId, field, val) => { const num = Math.max(0, parseInt(val, 10) || 0); setDivisionTargets((prev) => prev.map((row) => (row.id === divId ? { ...row, [field]: num } : row)) ); };
          const handleResetTargets = () => setDivisionTargets(initialDivisionTargets);

          // ======================================================================
          // AADHAAR DAILY TRANSACTION REPORT
          // Source: Google Sheet Aadhar Daily data already loaded in dataRows.
          // Column mapping is fixed to the requested Aadhar Daily layout:
          // J=Status, K=Inactive Reason, L=Enrolment, M=Updation, N=Total,
          // O=Revenue, P=Online Payment, Q=MBU Camps, S=MBU Enrolment,
