            return {
              totalApp473, totalPcc120, totalGangajal, revApp473, revPcc120, revGangajal, totalAadharRev, grandTotalRevenue, officeCount: regionalMasterOffices.length, divisionCount: divisions.size, recordCount: filteredRows.length,
