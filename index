                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label className="block font-semibold text-slate-700 mb-1">Office Name</label><input type="text" required value={formData.officeName} onChange={(e) => setFormData({ ...formData, officeName: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div><div><label className="block font-semibold text-slate-700 mb-1">Office Type</label><select value={formData.officeType} onChange={(e) => setFormData({ ...formData, officeType: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500"><option value="HPO">HPO (Head Post Office)</option><option value="SPO">SPO (Sub Post Office)</option><option value="GPO">GPO (General Post Office)</option><option value="BPC">BPC (Booking Counter)</option></select></div></div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label className="block font-semibold text-slate-700 mb-1">Division</label><input type="text" value={formData.division} onChange={(e) => setFormData({ ...formData, division: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div><div><label className="block font-semibold text-slate-700 mb-1">Sub Division</label><input type="text" value={formData.subDiv} onChange={(e) => setFormData({ ...formData, subDiv: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div></div>
                      <div className="p-3 bg-slate-50 rounded-lg border border-slate-200 space-y-3"><span className="font-bold text-slate-800 block text-xs">Operational Metrics</span><div className="grid grid-cols-3 gap-2"><div><label className="block text-slate-600 mb-1">App @ ₹473/-</label><input type="number" min="0" value={formData.app473} onChange={(e) => setFormData({ ...formData, app473: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div><div><label className="block text-slate-600 mb-1">PCC @ ₹120/-</label><input type="number" min="0" value={formData.pcc120} onChange={(e) => setFormData({ ...formData, pcc120: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div><div><label className="block text-slate-600 mb-1">Gangajal (@ ₹30)</label><input type="number" min="0" value={formData.gangajal} onChange={(e) => setFormData({ ...formData, gangajal: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div></div></div>
                      <div className="flex justify-end gap-2 pt-3 border-t border-slate-100"><button type="button" onClick={() => setEditingItem(null)} className="px-4 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50 font-medium">Cancel</button><button type="submit" className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold shadow-xs">Save Changes</button></div>
                    </form>
                  </div>
                </div>
              )}

              {/* ADD RECORD MODAL */}
              {isAddModalOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4 overflow-y-auto">
                  <div className="bg-white rounded-xl shadow-xl border border-slate-200 max-w-lg w-full p-5 space-y-4 my-8">
                    <div className="flex items-center justify-between border-b border-slate-100 pb-3"><div><h3 className="text-base font-bold text-slate-900">Add Operational Record</h3><p className="text-xs text-slate-500">Append new post office report entry to the sheet</p></div><button onClick={() => setIsAddModalOpen(false)} className="text-slate-400 hover:text-slate-600 p-1 rounded"><X className="w-5 h-5" /></button></div>
                    <form onSubmit={handleSaveAdd} className="space-y-3.5 text-xs">
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label className="block font-semibold text-slate-700 mb-1">Date (YYYY-MM-DD)</label><input type="text" required placeholder="2026-08-31" value={formData.date} onChange={(e) => setFormData({ ...formData, date: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div><div><label className="block font-semibold text-slate-700 mb-1">Office ID</label><input type="text" placeholder="e.g. 24360099" value={formData.officeId} onChange={(e) => setFormData({ ...formData, officeId: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div></div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label className="block font-semibold text-slate-700 mb-1">Office Name</label><input type="text" required placeholder="e.g. Wardha H.O" value={formData.officeName} onChange={(e) => setFormData({ ...formData, officeName: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div><div><label className="block font-semibold text-slate-700 mb-1">Office Type</label><select value={formData.officeType} onChange={(e) => setFormData({ ...formData, officeType: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500"><option value="HPO">HPO (Head Post Office)</option><option value="SPO">SPO (Sub Post Office)</option><option value="GPO">GPO (General Post Office)</option><option value="BPC">BPC (Booking Counter)</option></select></div></div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label className="block font-semibold text-slate-700 mb-1">Division</label><input type="text" placeholder="e.g. Wardha Division" value={formData.division} onChange={(e) => setFormData({ ...formData, division: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div><div><label className="block font-semibold text-slate-700 mb-1">Sub Division</label><input type="text" placeholder="e.g. Wardha East Sub Div" value={formData.subDiv} onChange={(e) => setFormData({ ...formData, subDiv: e.target.value })} className="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-800 focus:ring-2 focus:ring-indigo-500" /></div></div>
                      <div className="p-3 bg-slate-50 rounded-lg border border-slate-200 space-y-3"><span className="font-bold text-slate-800 block text-xs">Operational Metrics</span><div className="grid grid-cols-3 gap-2"><div><label className="block text-slate-600 mb-1">App @ ₹473/-</label><input type="number" min="0" value={formData.app473} onChange={(e) => setFormData({ ...formData, app473: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div><div><label className="block text-slate-600 mb-1">PCC @ ₹120/-</label><input type="number" min="0" value={formData.pcc120} onChange={(e) => setFormData({ ...formData, pcc120: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div><div><label className="block text-slate-600 mb-1">Gangajal (@ ₹30)</label><input type="number" min="0" value={formData.gangajal} onChange={(e) => setFormData({ ...formData, gangajal: e.target.value })} className="w-full bg-white border border-slate-300 rounded p-1.5 text-slate-800 font-semibold" /></div></div></div>
                      <div className="flex justify-end gap-2 pt-3 border-t border-slate-100"><button type="button" onClick={() => setIsAddModalOpen(false)} className="px-4 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50 font-medium">Cancel</button><button type="submit" className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold shadow-xs">Insert Record</button></div>
                    </form>
                  </div>
                </div>
              )}

              {/* DELETE CONFIRMATION MODAL */}
              {deletingItem && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
                  <div className="bg-white rounded-xl shadow-xl border border-slate-200 max-w-sm w-full p-5 space-y-4">
                    <div className="flex items-center gap-3"><div className="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center shrink-0"><AlertCircle className="w-5 h-5" /></div><div><h3 className="text-sm font-bold text-slate-900">Delete Record?</h3><p className="text-xs text-slate-500">Are you sure you want to remove Row #{deletingItem.index_} ({deletingItem.row?.[colMap.officeName] || 'Record'})?</p></div></div>
                    <div className="bg-slate-50 p-3 rounded-lg text-xs space-y-1 text-slate-600 border border-slate-100"><div><span className="font-semibold">Date:</span> {formatDateSafe(deletingItem.row?.[colMap.date])}</div><div><span className="font-semibold">Division:</span> {deletingItem.row?.[colMap.division] || 'N/A'}</div></div>
                    <div className="flex justify-end gap-2"><button onClick={() => setDeletingItem(null)} className="px-3 py-1.5 border border-slate-300 rounded-lg text-xs font-medium text-slate-700 hover:bg-slate-50">Cancel</button><button onClick={handleConfirmDelete} className="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold shadow-xs">Yes, Delete</button></div>
                  </div>
                </div>
              )}
            </div>
          );
        }

        // Backend Integration Wrapper — resilient Google Sheets sync + local cache
        const GSHEET_API_URL = "https://script.google.com/macros/s/AKfycbzLvty_jqHrwi-zv5QW2YnKszQYbnFA-uNlvfH2OE3XdQQs6A0uZ2ObpBnh7kbl8T8h6Q/exec?action=getData";
        const CACHE_KEY = "ccs_dashboard_cache_v3";

        function formatSheetRows(rows) {
            return (rows || []).map((row, idx) => ({
                index_: idx + 1,
                row: Array.isArray(row) ? row : [],
            }));
        }

        function readCache() {
            try {
                const raw = localStorage.getItem(CACHE_KEY);
                if (!raw) return null;
                const parsed = JSON.parse(raw);
                if (parsed && Array.isArray(parsed.data) && parsed.data.length) return parsed;
            } catch (e) { /* ignore */ }
            return null;
        }

        function writeCache(rows) {
            try {
                localStorage.setItem(CACHE_KEY, JSON.stringify({
                    savedAt: new Date().toISOString(),
                    data: rows,
                }));
            } catch (e) { /* quota / private mode */ }
        }

        function DashboardWrapper() {
            const cached = readCache();
            const [data, setData] = useState(cached ? formatSheetRows(cached.data) : []);
            const [loading, setLoading] = useState(!cached);
            const [syncError, setSyncError] = useState(null);
            const [lastSynced, setLastSynced] = useState(cached?.savedAt || null);
            const [isRefreshing, setIsRefreshing] = useState(false);

            const loadFromApi = React.useCallback(async (isManual = false) => {
                if (isManual) setIsRefreshing(true);
                else if (!cached) setLoading(true);
                setSyncError(null);
                try {
                    const controller = new AbortController();
                    const timer = setTimeout(() => controller.abort(), 45000);
                    const res = await fetch(GSHEET_API_URL, {
                        method: "GET",
                        mode: "cors",
                        cache: "no-store",
                        signal: controller.signal,
                    });
                    clearTimeout(timer);
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const json = await res.json();
                    const rows = Array.isArray(json?.data) ? json.data
                        : Array.isArray(json) ? json
                        : null;
                    if (!rows || !rows.length) {
                        throw new Error(json?.message || "Empty response from Google Sheets");
                    }
                    const formatted = formatSheetRows(rows);
                    setData(formatted);
                    writeCache(rows);
                    setLastSynced(new Date().toISOString());
                    setSyncError(null);
                } catch (err) {
                    console.error("Failed to fetch dashboard data:", err);
                    const msg = err?.name === "AbortError"
                        ? "Request timed out while contacting Google Sheets"
                        : (err?.message || "Network / CORS error");
                    setData(prev => {
                        if (!prev.length) setSyncError(msg);
                        else setSyncError(`Live sync failed (${msg}). Showing cached data.`);
                        return prev;
                    });
                } finally {
                    setLoading(false);
                    setIsRefreshing(false);
                }
            }, []);

            useEffect(() => {
                loadFromApi(false);
            }, [loadFromApi]);

            const updateItem = (index_, updatedRow) => {
                setData(prev => {
                    const next = prev.map(item => item.index_ === index_ ? { ...item, row: updatedRow } : item);
                    writeCache(next.map(d => d.row));
                    return next;
                });
            };

            const deleteItem = (index_) => {
                setData(prev => {
                    const next = prev.filter(item => item.index_ !== index_);
                    writeCache(next.map(d => d.row));
                    return next;
                });
            };

            const insertItem = (_, newRow) => {
                setData(prev => {
                    const newIdx = prev.length > 0 ? Math.max(...prev.map(d => d.index_)) + 1 : 1;
                    const next = [...prev, { index_: newIdx, row: newRow }];
                    writeCache(next.map(d => d.row));
                    return next;
                });
            };

            const moveItem = (fromIdx, toIdx) => {
                setData(prev => {
                  const arr = [...prev];
                  const fromIndex = arr.findIndex(x => x.index_ === fromIdx);
                  const toIndex = arr.findIndex(x => x.index_ === toIdx);
                  if(fromIndex >= 0 && toIndex >= 0) {
                     const [moved] = arr.splice(fromIndex, 1);
                     arr.splice(toIndex, 0, moved);
                  }
                  writeCache(arr.map(d => d.row));
                  return arr;
                });
            };

            if (loading && !data.length) {
                return (
                    <div className="flex items-center justify-center min-h-screen bg-slate-50">
                        <div className="text-center space-y-4">
                            <div className="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mx-auto"></div>
                            <h2 className="text-lg font-semibold text-slate-700">Connecting to Google Sheets...</h2>
                            <p className="text-sm text-slate-500">Fetching live regional performance data</p>
                        </div>
                    </div>
                );
            }

            if (!loading && !data.length && syncError) {
                return (
                    <div className="flex items-center justify-center min-h-screen bg-slate-50 p-6">
                        <div className="max-w-md w-full bg-white border border-rose-200 rounded-2xl shadow-xs p-6 space-y-4 text-center">
                            <div className="w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto"><AlertCircle className="w-6 h-6" /></div>
                            <h2 className="text-lg font-bold text-slate-900">Unable to load data</h2>
                            <p className="text-sm text-slate-600">{syncError}</p>
                            <p className="text-xs text-slate-400">Open this file via a local web server (not file://) if CORS blocks the request, and confirm the Apps Script web app is deployed as &quot;Anyone&quot;.</p>
                            <button type="button" onClick={() => loadFromApi(true)} className="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold">
                                <RefreshCw className="w-4 h-4" /> Retry Sync
                            </button>
                        </div>
                    </div>
                );
            }

            return (
              <div className="relative">
                {(syncError || isRefreshing) && (
                  <div className={`no-print sticky top-0 z-[90] px-3 py-2 text-center text-xs font-semibold border-b ${syncError ? 'bg-amber-50 text-amber-900 border-amber-200' : 'bg-indigo-50 text-indigo-800 border-indigo-200'}`}>
                    {isRefreshing ? 'Refreshing from Google Sheets…' : syncError}
                    {!isRefreshing && (
                      <button type="button" onClick={() => loadFromApi(true)} className="ml-3 underline hover:no-underline">Retry</button>
                    )}
                    {lastSynced && !isRefreshing && (
                      <span className="ml-3 font-normal opacity-80">Last sync: {new Date(lastSynced).toLocaleString('en-IN')}</span>
                    )}
                  </div>
                )}
                <App data={data} updateItem={updateItem} deleteItem={deleteItem} insertItem={insertItem} moveItem={moveItem} onRefresh={() => loadFromApi(true)} isRefreshing={isRefreshing} lastSynced={lastSynced} />
              </div>
            );
        }

        const rootElement = document.getElementById('root');
        const root = createRoot(rootElement);
        root.render(<DashboardWrapper />);
    </script>
</body>
</html>
