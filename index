            masterOffices.forEach((o) => { if (map.has(o.name)) { const entry = map.get(o.name); entry.division = o.division; entry.subDiv = o.subDiv; entry.officeType = o.officeType; entry.officeId = o.id; } });
            filteredRows.forEach((item) => {
              const r = item.row || []; const name = String(r[colMap.officeName] || '').trim();
              if (map.has(name)) {
                const entry = map.get(name);
                if (!entry.division && r[colMap.division]) entry.division = r[colMap.division]; if (!entry.subDiv && r[colMap.subDiv]) entry.subDiv = r[colMap.subDiv];
                if (!entry.officeId && r[colMap.officeId]) entry.officeId = r[colMap.officeId]; if (!entry.officeType && r[colMap.officeType]) entry.officeType = r[colMap.officeType];
                const a = parseNum(r[colMap.app473]), p = parseNum(r[colMap.pcc120]), revA = a * 473, revP = p * 120, revTot = revA + revP;
